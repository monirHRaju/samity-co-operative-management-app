/// Samity Cooperative Management System - Prisma Schema
/// All monetary values stored in paisa (integer) where 100 paisa = 1 taka

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ACCOUNTANT
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum AccountType {
  CASH
  BANK
}

enum AccountTransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
}

enum ReferenceType {
  SAVING
  LOAN_DISBURSEMENT
  LOAN_PAYMENT
  INVESTMENT
  EXPENSE
  INCOME
  TRANSFER
  OTHER
}

enum LoanStatus {
  PENDING
  APPROVED
  ACTIVE
  COMPLETED
  DEFAULTED
}

enum InstallmentType {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum LoanScheduleStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
}

enum InvestmentType {
  ASSET
  FDR
  SAVINGS_CERTIFICATE
  OTHER
}

enum InvestmentStatus {
  ACTIVE
  MATURED
  SOLD
  CLOSED
}

enum InvestmentTransactionType {
  PURCHASE
  RETURN
  PROFIT
  PARTIAL_RETURN
}

enum IncomeExpenseType {
  INCOME
  EXPENSE
}

enum JournalEntrySourceType {
  SAVING
  LOAN
  INVESTMENT
  INCOME_EXPENSE
  TRANSFER
  ACCOUNT
  OTHER
}

enum JournalLineType {
  DEBIT
  CREDIT
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String   // hashed
  role          Role
  isActive      Boolean  @default(true)
  memberId      String?  @unique
  refreshToken  String?
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Relations
  member                    Member?                  @relation("MemberUser", fields: [memberId], references: [id])
  memberSavingsCollected    MemberSaving[]           @relation("MemberSavingCollectedBy")
  accountTransactionsPerformed AccountTransaction[] @relation("AccountTransactionPerformedBy")
  loansApproved             Loan[]                   @relation("LoanApprovedBy")
  loanPaymentsCollected     LoanPayment[]            @relation("LoanPaymentCollectedBy")
  incomeExpensesPerformed   IncomeExpense[]          @relation("IncomeExpensePerformedBy")
  journalEntriesCreated     JournalEntry[]           @relation("JournalEntryCreatedBy")

  @@map("users")
}

model Member {
  id            String   @id @default(cuid())
  memberNo      String   @unique
  name          String
  fatherName    String
  motherName    String
  phone         String   @unique
  address       String
  nidNumber     String   @unique
  photo         String?
  nomineeName   String
  nomineePhone  String
  nomineeRelation String
  joinDate      DateTime
  status        MemberStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Relations
  user          User?      @relation("MemberUser")
  savings       MemberSaving[]
  loans         Loan[]

  @@map("members")
}

model MemberSaving {
  id            String   @id @default(cuid())
  member        Member   @relation(fields: [memberId], references: [id])
  memberId      String
  amount        Int      // in paisa
  month         Int      // 1-12
  year          Int
  note          String?
  collectedBy   User     @relation("MemberSavingCollectedBy", fields: [collectedById], references: [id])
  collectedById String
  collectedAt   DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([memberId, month, year])
  @@map("member_savings")
}

model Account {
  id            String   @id @default(cuid())
  name          String   // e.g. "Islami Bank", "Hand Cash"
  type          AccountType
  bankName      String?
  accountNumber String?
  currentBalance Int      // in paisa
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Relations
  transactions              AccountTransaction[] 
  loansDisbursedFrom        Loan[]                @relation("LoanDisbursedFrom")
  loanPaymentsDeposited     LoanPayment[]         @relation("LoanPaymentAccount")
  investments               Investment[]          @relation("InvestmentAccount")
  investmentTransactions    InvestmentTransaction[] @relation("InvestmentTransactionAccount")
  incomeExpenses            IncomeExpense[]       @relation("IncomeExpenseAccount")

  @@map("accounts")
}

model AccountTransaction {
  id            String   @id @default(cuid())
  account       Account  @relation(fields: [accountId], references: [id])
  accountId     String
  type          AccountTransactionType
  amount        Int      // in paisa
  balanceAfter  Int      // in paisa
  description   String?
  referenceType ReferenceType?
  referenceId   String?
  performedBy   User     @relation("AccountTransactionPerformedBy", fields: [performedById], references: [id])
  performedById String
  createdAt     DateTime @default(now())

  @@map("account_transactions")
}

model Loan {
  id              String   @id @default(cuid())
  loanNo          String   @unique
  member          Member   @relation(fields: [memberId], references: [id])
  memberId        String
  amount          Int      // in paisa (principal)
  profitRate      Decimal  // e.g. 10.5 for 10.5%
  profitAmount    Int      // in paisa (total profit)
  totalPayable    Int      // in paisa (principal + profit)
  duration        Int      // number of installments
  installmentType InstallmentType
  installmentAmount Int   // in paisa
  disbursedAt     DateTime?
  disbursedFrom   Account? @relation("LoanDisbursedFrom", fields: [disbursedFromId], references: [id])
  disbursedFromId String?
  status          LoanStatus
  approvedBy      User?    @relation("LoanApprovedBy", fields: [approvedById], references: [id])
  approvedById    String?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Relations
  schedules     LoanSchedule[]
  payments      LoanPayment[]

  @@map("loans")
}

model LoanSchedule {
  id          String   @id @default(cuid())
  loan        Loan     @relation(fields: [loanId], references: [id])
  loanId      String
  installmentNo Int
  dueDate     DateTime
  dueAmount   Int      // in paisa
  status      LoanScheduleStatus
  createdAt   DateTime @default(now())

  /// Relations
  loanPayments LoanPayment[] @relation("LoanPaymentSchedule")

  @@map("loan_schedules")
}

model LoanPayment {
  id            String   @id @default(cuid())
  loan          Loan     @relation(fields: [loanId], references: [id])
  loanId        String
  schedule      LoanSchedule? @relation("LoanPaymentSchedule", fields: [scheduleId], references: [id])
  scheduleId    String?
  amount        Int      // in paisa
  paymentDate   DateTime
  collectedBy   User     @relation("LoanPaymentCollectedBy", fields: [collectedById], references: [id])
  collectedById String
  accountId     String   // account where money is deposited
  account       Account  @relation("LoanPaymentAccount", fields: [accountId], references: [id])
  note          String?
  createdAt     DateTime @default(now())

  @@map("loan_payments")
}

model Investment {
  id            String   @id @default(cuid())
  investmentNo  String   @unique
  type          InvestmentType
  title         String
  description   String?
  purchaseAmount Int      // in paisa
  purchaseDate  DateTime
  maturityDate  DateTime?
  expectedReturn Int?     // in paisa
  actualReturn  Int?     // in paisa
  status        InvestmentStatus
  accountId     String   // account from which investment was made
  account       Account  @relation("InvestmentAccount", fields: [accountId], references: [id])
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Relations
  transactions  InvestmentTransaction[]

  @@map("investments")
}

model InvestmentTransaction {
  id            String   @id @default(cuid())
  investment    Investment @relation(fields: [investmentId], references: [id])
  investmentId  String
  type          InvestmentTransactionType
  amount        Int      // in paisa
  date          DateTime
  accountId     String   // account involved in transaction (where money came from/goes)
  account       Account  @relation("InvestmentTransactionAccount", fields: [accountId], references: [id])
  note          String?
  createdAt     DateTime @default(now())

  @@map("investment_transactions")
}

model IncomeExpense {
  id            String   @id @default(cuid())
  type          IncomeExpenseType
  category      String   // e.g. "Office Rent", "Loan Profit"
  amount        Int      // in paisa
  date          DateTime
  accountId     String   // account involved
  account       Account  @relation("IncomeExpenseAccount", fields: [accountId], references: [id])
  description   String?
  referenceId   String?  // optional reference to other entities (e.g. loanId, investmentId)
  performedBy   User     @relation("IncomeExpensePerformedBy", fields: [performedById], references: [id])
  performedById String
  createdAt     DateTime @default(now())

  @@map("income_expenses")
}

model JournalEntry {
  id            String   @id @default(cuid())
  entryNo       String   @unique
  date          DateTime
  description   String
  sourceType    JournalEntrySourceType
  sourceId      String?
  createdBy     User     @relation("JournalEntryCreatedBy", fields: [createdById], references: [id])
  createdById   String
  createdAt     DateTime @default(now())

  /// Relations
  lines         JournalLine[]

  @@map("journal_entries")
}

model JournalLine {
  id            String   @id @default(cuid())
  journalEntry  JournalEntry @relation(fields: [journalEntryId], references: [id])
  journalEntryId String
  accountCode   String   // e.g. "1000" for Cash, "2000" for Bank, etc.
  accountName   String
  type          JournalLineType
  amount        Int      // in paisa
  createdAt     DateTime @default(now())

  @@map("journal_lines")
}
